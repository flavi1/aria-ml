
[role="tab"] {
	behavior: tab;
	rel-tablist: "(closest: [role=tablist]) [role=tab]";
	rel-tabpanel: "(root) #{aria-controls}";
	on-click: behavior() log(tablist/tabpanel);
	on-init: log(tablist/tabpanel);
	on-attach: log(tablist/tabpanel);
}

#masthead {
	rel-list: "a";
	on-current-change: update-current(page, list@href);
}

#toc {
	rel-list: "a";
	on-current-change: update-current(location, list@href);
}
